#!/usr/bin/env python3
"""paseo-chat: утилита межсессионного взаимодействия и изучения чатов в Paseo."""

import json
import os
import re
import subprocess
import sys


def extract_agent_id(input_str: str) -> str:
    """Извлекает agentId из строки, deep link paseo:///h/.../agent/<id>, веб-ссылки или UUID."""
    s = input_str.strip()
    # Ищем UUID или хэш после agent/ или agent: или в начале строки
    m = re.search(
        r"(?:agent[/:]|^)([0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?|[0-9a-fA-F]{7,})",
        s,
    )
    if m:
        return m.group(1)
    # Если передан просто путь или строка без префиксов
    parts = s.rstrip("/").split("/")
    return parts[-1]


def run_cmd(args):
    try:
        res = subprocess.run(args, capture_output=True, text=True, check=True)
        return res.stdout
    except subprocess.CalledProcessError as e:
        print(f"Ошибка выполнения: {e.stderr or e.stdout}", file=sys.stderr)
        sys.exit(e.returncode)


def cmd_ls(args):
    out = run_cmd(["paseo", "agent", "ls", "--json"])
    try:
        agents = json.loads(out)
    except Exception as e:
        print(f"Не удалось распарсить список агентов: {e}", file=sys.stderr)
        sys.exit(1)

    if not agents:
        print("Нет активных чатов.")
        return

    print(f"{'ID':<10} {'СТАТУС':<10} {'ВОРКСПЕЙС':<25} {'НАЗВАНИЕ ЧАТА'}")
    print("-" * 80)
    for a in agents:
        short_id = a.get("shortId", a.get("id", "")[:7])
        status = a.get("status", "unknown")
        cwd = a.get("cwd", "")
        if cwd.startswith("/home/"):
            parts = cwd.split("/")
            cwd = "~/" + "/".join(parts[3:]) if len(parts) > 3 else cwd
        name = a.get("name", "Без названия")
        if len(name) > 38:
            name = name[:35] + "..."
        print(f"{short_id:<10} {status:<10} {cwd:<25} {name}")


def cmd_read(args):
    if not args:
        print("Использование: paseo-chat read <agent-id-or-url> [--tail N]", file=sys.stderr)
        sys.exit(1)

    target_raw = args[0]
    agent_id = extract_agent_id(target_raw)
    extra_args = []

    if "--tail" in args:
        idx = args.index("--tail")
        if idx + 1 < len(args):
            extra_args.extend(["--tail", args[idx + 1]])

    cmd = ["paseo", "agent", "logs", agent_id] + extra_args
    try:
        proc = subprocess.run(cmd)
        sys.exit(proc.returncode)
    except Exception as e:
        print(f"Ошибка запуска чтения логов: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_send(args):
    if len(args) < 2:
        print("Использование: paseo-chat send <agent-id-or-url> <сообщение>", file=sys.stderr)
        sys.exit(1)

    target_raw = args[0]
    agent_id = extract_agent_id(target_raw)
    message = " ".join(args[1:])

    cmd = ["paseo", "agent", "send", "--behavior", "steer", agent_id, message]
    try:
        proc = subprocess.run(cmd)
        sys.exit(proc.returncode)
    except Exception as e:
        print(f"Ошибка отправки сообщения: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_link(args):
    if not args:
        print("Использование: paseo-chat link <agent-id-or-url>", file=sys.stderr)
        sys.exit(1)

    agent_id = extract_agent_id(args[0])
    server_id = os.environ.get("PASEO_SERVER_ID", "local")
    print(f"paseo:///h/{server_id}/agent/{agent_id}")


def cmd_inspect(args):
    if not args:
        print("Использование: paseo-chat inspect <agent-id-or-url>", file=sys.stderr)
        sys.exit(1)

    agent_id = extract_agent_id(args[0])
    cmd = ["paseo", "agent", "inspect", agent_id, "--json"]
    proc = subprocess.run(cmd)
    sys.exit(proc.returncode)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("Утилита paseo-chat для межсессионного взаимодействия в Paseo\n")
        print("Команды:")
        print("  paseo-chat ls                      Список активных чатов")
        print("  paseo-chat link <id-or-url>        Получить нативную ссылку paseo:///h/local/agent/<id>")
        print("  paseo-chat read <id-or-url> [--tail N]  Изучить историю/контекст другого чата")
        print("  paseo-chat send <id-or-url> <текст>    Отправить сообщение в другой чат (режим steer)")
        print("  paseo-chat inspect <id-or-url>     Посмотреть параметры и модель агента")
        sys.exit(0)

    subcmd = sys.argv[1]
    subargs = sys.argv[2:]

    if subcmd == "ls":
        cmd_ls(subargs)
    elif subcmd in ("read", "logs", "cat"):
        cmd_read(subargs)
    elif subcmd in ("send", "msg"):
        cmd_send(subargs)
    elif subcmd == "link":
        cmd_link(subargs)
    elif subcmd == "inspect":
        cmd_inspect(subargs)
    else:
        # Если первой передана ссылка или ID, а дальше команда или сразу чтение
        agent_id = extract_agent_id(subcmd)
        if subargs:
            cmd_send([agent_id] + subargs)
        else:
            cmd_read([agent_id])


if __name__ == "__main__":
    main()
